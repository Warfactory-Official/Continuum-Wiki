---
// The datapack and addon template form. The templates and the CurseForge file ids come from
// public/generator/manifest.json (scripts/templates.mjs); src/generator/generate.js fills and zips them in the browser.
import { DATAPACK_VERSIONS, LICENSES, NODES } from '../generator/generate.js';

const manifestUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/generator/manifest.json`;
---

<div class="tg not-content" data-manifest={manifestUrl}>
	<div class="tg-kind" role="radiogroup" aria-label="What to make">
		<label><input type="radio" name="tg-kind" value="datapack" checked /> Datapack</label>
		<label><input type="radio" name="tg-kind" value="addon" /> Addon mod</label>
	</div>

	<form class="tg-form" data-kind="datapack" novalidate>
		<label>Pack name <input name="packName" value="My HBM tweaks" required /></label>
		<label>Namespace <input name="namespace" value="mypack" required spellcheck="false" />
			<small>Your files go under <code>data/&lt;namespace&gt;/</code>. Never <code>hbm</code>.</small></label>
		<label>Description <input name="description" placeholder="Shown in /datapack list" /></label>
		<fieldset>
			<legend>Minecraft versions</legend>
			{DATAPACK_VERSIONS.map((v) => <label class="tg-check"><input type="checkbox" name="versions" value={v.id} checked /> {v.label}</label>)}
			<small>Picking 1.20.1 with a newer version adds an overlay for the renamed vanilla folders.</small>
		</fieldset>
		<label class="tg-check"><input type="checkbox" name="example" checked /> Example Burner Press recipe</label>
	</form>

	<form class="tg-form" data-kind="addon" novalidate hidden>
		<label>Mod name <input name="modName" value="My Addon" required /></label>
		<label>Mod id <input name="modId" value="myaddon" required spellcheck="false" /></label>
		<label>Java package <input name="package" value="com.example.myaddon" required spellcheck="false" /></label>
		<label>Main class <input name="className" value="MyAddon" required spellcheck="false" /></label>
		<label>Author <input name="author" value="" required /></label>
		<label>Version <input name="version" value="0.1.0" required spellcheck="false" /></label>
		<label>License <select name="license">
			{LICENSES.map((l) => <option value={l.id} selected={l.id === 'LGPL-3.0-only'}>{l.label}</option>)}
		</select></label>
		<label>Description <input name="description" placeholder="An addon for NTM - Continuum." /></label>
		<label>Homepage <input name="homepage" placeholder="https://github.com/you/myaddon" spellcheck="false" />
			<small>Optional. Linked from the mod list; a GitHub repository also gives the issues link.</small></label>
		<fieldset>
			<legend>Targets</legend>
			{NODES.map((n) => <label class="tg-check"><input type="checkbox" name="nodes" value={n.id} checked /> {n.label}</label>)}
		</fieldset>
		<label class="tg-check"><input type="checkbox" name="example" checked /> Example block, crafting recipe, assembly machine recipe and hook</label>
	</form>

	<div class="tg-actions">
		<button type="button" class="tg-download" disabled>Download zip</button>
		<span class="tg-status" aria-live="polite">Loading templates…</span>
	</div>
	<details class="tg-files">
		<summary>Files in the zip</summary>
		<pre></pre>
	</details>
</div>

<script>
	import { classNameFor, generateFiles, generateZip, validate } from '../generator/generate.js';

	const root = document.querySelector<HTMLElement>('.tg')!;
	const forms = Object.fromEntries([...root.querySelectorAll<HTMLFormElement>('.tg-form')].map((f) => [f.dataset.kind, f]));
	const button = root.querySelector<HTMLButtonElement>('.tg-download')!;
	const status = root.querySelector<HTMLElement>('.tg-status')!;
	const fileList = root.querySelector('.tg-files pre')!;
	let manifest: any = null;
	let kind = 'datapack';

	function settings(form: HTMLFormElement) {
		const s: Record<string, any> = {};
		for (const el of form.querySelectorAll<HTMLInputElement>('input[name], select[name]')) {
			if (el.type === 'checkbox' && el.name !== 'example') (s[el.name] ??= []).push(...(el.checked ? [el.value] : []));
			else if (el.type === 'checkbox') s[el.name] = el.checked;
			else s[el.name] = el.value.trim();
		}
		return s;
	}

	// Errors show only for fields the reader has changed, so a fresh form is not all red.
	const edited = new Set<string>();

	function showErrors(form: HTMLFormElement, errors: Record<string, string>) {
		for (const el of form.querySelectorAll('.tg-field-error')) el.remove();
		for (const [name, message] of Object.entries(errors)) {
			if (!edited.has(name)) continue;
			const field = form.querySelector(`[name="${name}"]`)?.closest('label, fieldset');
			const p = document.createElement('small');
			p.className = 'tg-field-error';
			p.textContent = message;
			field?.append(p);
		}
	}

	function labelOf(form: HTMLFormElement, name: string) {
		const field = form.querySelector(`[name="${name}"]`)?.closest('label, fieldset');
		const text = field?.querySelector('legend')?.textContent ?? field?.firstChild?.textContent ?? name;
		return text.trim().toLowerCase();
	}

	function refresh() {
		const form = forms[kind];
		const s = settings(form);
		const errors = validate(kind, s);
		showErrors(form, errors);
		const ok = manifest && Object.keys(errors).length === 0;
		button.disabled = !ok;
		if (!manifest) return;
		const missing = Object.keys(errors).filter((k) => !edited.has(k));
		const r = manifest.releases;
		const built = new Date(manifest.built).toLocaleDateString();
		status.textContent = kind === 'addon'
			? `Golem Core ${r.golemcore.version} and NTM - Continuum ${r.hbm.version} from GitHub, GemRender ${r.gemrender.version} from CurseForge, checked ${built}.`
			: '';
		if (missing.length) status.textContent = `Still to fill in: ${missing.map((k) => labelOf(form, k)).join(', ')}.`;
		fileList.textContent = ok
			? generateFiles(manifest, kind, s).map((f) => (kind === 'addon' ? s.modId : s.namespace) + '/' + f.path).sort().join('\n')
			: 'Fix the fields above to see the files.';
	}

	// Mod id, package and class follow the name until the reader edits them.
	const addon = forms.addon;
	const touched = new Set<string>();
	for (const name of ['modId', 'package', 'className']) {
		addon.querySelector(`[name="${name}"]`)!.addEventListener('input', () => touched.add(name));
	}
	addon.querySelector('[name="modName"]')!.addEventListener('input', (e) => {
		const name = (e.target as HTMLInputElement).value;
		const set = (field: string, value: string) => {
			if (!touched.has(field)) (addon.querySelector(`[name="${field}"]`) as HTMLInputElement).value = value;
		};
		const id = name.toLowerCase().replace(/[^a-z0-9]+/g, '').replace(/^[0-9]+/, '').slice(0, 64);
		set('modId', id);
		set('package', `com.example.${id || 'myaddon'}`);
		set('className', classNameFor(name));
	});
	addon.querySelector('[name="modId"]')!.addEventListener('input', (e) => {
		const id = (e.target as HTMLInputElement).value;
		if (!touched.has('package')) (addon.querySelector('[name="package"]') as HTMLInputElement).value = `com.example.${id}`;
	});

	for (const radio of root.querySelectorAll<HTMLInputElement>('input[name="tg-kind"]')) {
		radio.addEventListener('change', () => {
			kind = radio.value;
			for (const [k, f] of Object.entries(forms)) f.hidden = k !== kind;
			refresh();
		});
	}
	for (const form of Object.values(forms)) {
		form.addEventListener('input', (e) => {
			edited.add((e.target as HTMLInputElement).name);
			refresh();
		});
		form.addEventListener('submit', (e) => e.preventDefault());
	}

	button.addEventListener('click', () => {
		const { name, bytes } = generateZip(manifest, kind, settings(forms[kind]));
		const url = URL.createObjectURL(new Blob([bytes], { type: 'application/zip' }));
		const a = Object.assign(document.createElement('a'), { href: url, download: name });
		a.click();
		setTimeout(() => URL.revokeObjectURL(url), 10000);
	});

	fetch(root.dataset.manifest!)
		.then((r) => {
			if (!r.ok) throw new Error(`HTTP ${r.status}`);
			return r.json();
		})
		.then((m) => {
			manifest = m;
			status.textContent = '';
			refresh();
		})
		.catch((e) => {
			status.textContent = `Could not load the templates (${e.message}). Reload the page to try again.`;
		});
</script>

<style>
	.tg {
		display: grid;
		gap: 1rem;
		margin-block: 1.5rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-7, var(--sl-color-black));
	}
	.tg-kind {
		display: flex;
		gap: 1.5rem;
		font-weight: 600;
	}
	.tg-form {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 0.75rem 1.25rem;
	}
	.tg-form {
		align-items: start;
	}
	.tg-form[hidden] {
		display: none;
	}
	.tg-form > label,
	.tg-form fieldset {
		display: grid;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.tg-form fieldset {
		grid-column: 1 / -1;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		padding: 0.5rem 0.75rem 0.75rem;
	}
	.tg-form fieldset small {
		grid-column: 1 / -1;
	}
	.tg-form legend {
		padding-inline: 0.25rem;
	}
	.tg input:not([type]),
	.tg select {
		font: inherit;
		font-size: var(--sl-text-base);
		color: var(--sl-color-white);
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		padding: 0.375rem 0.5rem;
		min-width: 0;
	}
	.tg input:focus-visible,
	.tg select:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}
	.tg-check {
		display: flex !important;
		align-items: center;
		gap: 0.5rem;
		grid-column: 1 / -1;
	}
	fieldset .tg-check {
		grid-column: auto;
	}
	.tg small {
		color: var(--sl-color-gray-3);
	}
	.tg .tg-field-error {
		color: var(--sl-color-red-high, #f87171);
	}
	.tg-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}
	.tg-download {
		font: inherit;
		font-weight: 600;
		padding: 0.5rem 1.25rem;
		border: 0;
		border-radius: 999rem;
		color: var(--sl-color-black);
		background: var(--sl-color-accent);
		cursor: pointer;
	}
	.tg-download:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}
	.tg-status {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.tg-files summary {
		cursor: pointer;
		font-size: var(--sl-text-sm);
	}
	.tg-files pre {
		margin-top: 0.5rem;
		max-height: 20rem;
		overflow: auto;
		font-size: var(--sl-text-xs);
		padding: 0.75rem;
		border-radius: 0.25rem;
		background: var(--sl-color-black);
	}
</style>
